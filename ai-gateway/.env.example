# AI Gateway — Environment Variables
# Copy this file to .env and fill in the values

# Sarvam AI API key (required for real AI calls)
SARVAM_API_KEY=your_sarvam_api_key_here

# Sarvam API endpoint
SARVAM_API_URL=https://api.sarvam.ai/chat/completions

# Downstream service URLs
BOOKING_SERVICE_URL=http://localhost:8001
PRIVACY_SERVICE_URL=http://localhost:8002

# Set to "true" to use mock responses when downstream services are unavailable
USE_MOCKS=true

# Gateway port
GATEWAY_PORT=8000
